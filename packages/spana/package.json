{
  "name": "spana-test",
  "version": "0.19.0",
  "description": "The fastest AI-native E2E framework — one TypeScript test across Web, iOS, Android, Electron, Electrobun, and WASM",
  "keywords": [
    "android",
    "capacitor",
    "cross-platform",
    "e2e",
    "electrobun",
    "electron",
    "ios",
    "playwright",
    "react-native",
    "testing",
    "webview"
  ],
  "license": "Apache-2.0",
  "author": "Anton Wester",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wezter96/spana.git",
    "directory": "packages/spana"
  },
  "bin": {
    "spana": "dist/cli.js"
  },
  "files": [
    ".agents",
    "dist",
    "LICENSE",
    "native",
    "README.md",
    "studio-dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./steps": {
      "types": "./dist/gherkin/steps.d.ts",
      "import": "./dist/gherkin/steps.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "bun test",
    "test:e2e:framework-app": "bun run build && bun ./dist/cli.js test --config ./spana.config.ts",
    "test:watch": "bun test --watch",
    "check-types": "tsc --noEmit",
    "embed-studio": "bun scripts/embed-studio.ts",
    "postbuild": "bun scripts/embed-studio.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "^19.0.0",
    "@cucumber/gherkin": "^39.0.0",
    "@cucumber/messages": "^32.2.0",
    "@hono/node-server": "~2.1.3",
    "@orpc/client": "1.14.10",
    "@orpc/server": "1.14.10",
    "@orpc/zod": "1.14.10",
    "@types/bun": "^1.2.0",
    "@types/pngjs": "^6.0.4",
    "axe-core": "^4.10.0",
    "effect": "^4.1.5",
    "hono": "^4.12.10",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.49.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@cucumber/cucumber-expressions": "^19.0.0",
    "@cucumber/gherkin": "^39.0.0",
    "@cucumber/messages": "^32.0.0",
    "axe-core": "^4.10.0",
    "effect": ">=4.1.0 <5.0.0",
    "playwright-core": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "@cucumber/cucumber-expressions": {
      "optional": true
    },
    "@cucumber/gherkin": {
      "optional": true
    },
    "@cucumber/messages": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  }
}
