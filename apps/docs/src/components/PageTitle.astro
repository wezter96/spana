---
import Default from "@astrojs/starlight/components/PageTitle.astro";

const { entry } = Astro.locals.starlightRoute;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? "https://spana.antonwester.se").href;
const relPath = entry.filePath.replace(/^.*?src\/content\/docs\//, "");
const rawUrl = `https://raw.githubusercontent.com/wezter96/spana/main/apps/docs/src/content/docs/${relPath}`;
// Title + source URL + raw page body, so an agent gets the context without fetching anything.
const markdown = `# ${entry.data.title}\n\nSource: ${pageUrl}\n\n${(entry.body ?? "").trim()}\n`;
---

<Default />
<div class="spana-page-actions">
  <button type="button" class="spana-copy-page" data-md={markdown}>
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
      ></path></svg
    >
    <span>Copy page for AI</span>
  </button>
  <a href={rawUrl} target="_blank" rel="noopener">View Markdown</a>
  <span class="spana-copy-status" role="status" aria-live="polite"></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".spana-copy-page")) {
    button.addEventListener("click", async () => {
      const status = button.parentElement?.querySelector(".spana-copy-status");
      try {
        await navigator.clipboard.writeText(button.dataset.md ?? "");
        if (status) status.textContent = "Copied. Paste it into your agent.";
      } catch {
        if (status) status.textContent = "Copy failed. Use View Markdown instead.";
      }
      setTimeout(() => status && (status.textContent = ""), 3000);
    });
  }
</script>

<style>
  .spana-page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .spana-copy-page {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--sl-color-hairline-shade, var(--sl-color-gray-5));
    border-radius: 8px;
    background: var(--sl-color-gray-6, transparent);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }
  .spana-copy-page:hover {
    border-color: var(--sl-color-accent);
  }
  .spana-copy-page:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .spana-page-actions a {
    color: var(--sl-color-gray-2);
  }
  .spana-copy-status {
    color: var(--spana-good, var(--sl-color-gray-2));
  }
</style>
