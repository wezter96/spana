---
// Pure-JS client-side search modal for Spana docs (zero WebAssembly, works under strict CSP).
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "");
const indexUrl = `${base}/search-index.json`;
---

<site-search class="sl-flex" data-index-url={indexUrl} data-base-url={base}>
  <button
    type="button"
    data-open-modal
    aria-label="Search"
    aria-keyshortcuts="Control+K Meta+K /"
  >
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <span class="sl-hidden md:sl-block" aria-hidden="true">Search</span>
    <kbd class="sl-hidden md:sl-flex" aria-hidden="true">
      <kbd data-shortcut-mod>⌘</kbd><kbd>K</kbd>
    </kbd>
  </button>

  <dialog aria-label="Search documentation">
    <div class="dialog-frame sl-flex">
      <div class="search-header">
        <div class="search-input-wrap">
          <svg aria-hidden="true" class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            class="search-input"
            placeholder="Search documentation…"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="Search documentation"
          />
          <button type="button" class="search-clear" aria-label="Clear search" hidden>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
        <button type="button" data-close-modal class="search-cancel">Cancel</button>
      </div>
      <div class="search-status" role="status" aria-live="polite"></div>
      <ol class="search-results" role="listbox" aria-label="Search results"></ol>
      <div class="search-footer">
        <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
        <span><kbd>↵</kbd> to select</span>
        <span><kbd>Esc</kbd> to close</span>
      </div>
    </div>
  </dialog>
</site-search>

<script>
  interface SearchSection {
    heading: string;
    anchor: string;
    text: string;
  }
  interface SearchEntry {
    url: string;
    title: string;
    description: string;
    sections: SearchSection[];
  }
  interface SearchHit {
    url: string;
    title: string;
    heading: string;
    excerpt: string;
    score: number;
  }

  let cachedIndex: SearchEntry[] | null = null;
  let indexPromise: Promise<SearchEntry[]> | null = null;

  function loadIndex(url: string): Promise<SearchEntry[]> {
    if (cachedIndex) return Promise.resolve(cachedIndex);
    if (!indexPromise) {
      indexPromise = fetch(url)
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json() as Promise<SearchEntry[]>;
        })
        .then((data) => {
          cachedIndex = data;
          return data;
        })
        .catch((err) => {
          indexPromise = null;
          throw err;
        });
    }
    return indexPromise;
  }

  function escapeHtml(str: string): string {
    return str
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  function highlight(text: string, terms: string[]): string {
    const safe = escapeHtml(text);
    if (terms.length === 0) return safe;
    const escaped = terms.map((t) => t.replaceAll(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    const re = new RegExp(`(${escaped.join("|")})`, "gi");
    return safe.replaceAll(re, "<mark>$1</mark>");
  }

  function makeExcerpt(text: string, terms: string[], maxLen = 160): string {
    if (!text) return "";
    const lower = text.toLowerCase();
    let bestIdx = -1;
    for (const t of terms) {
      const idx = lower.indexOf(t);
      if (idx !== -1 && (bestIdx === -1 || idx < bestIdx)) bestIdx = idx;
    }
    if (bestIdx === -1) {
      return text.length > maxLen ? `${text.slice(0, maxLen).trimEnd()}…` : text;
    }
    const start = Math.max(0, bestIdx - 48);
    const end = Math.min(text.length, start + maxLen);
    const prefix = start > 0 ? "…" : "";
    const suffix = end < text.length ? "…" : "";
    return `${prefix}${text.slice(start, end).trim()}${suffix}`;
  }

  function searchDocs(entries: SearchEntry[], rawQuery: string, baseUrl: string): SearchHit[] {
    const query = rawQuery.trim().toLowerCase();
    if (!query) return [];
    const terms = query.split(/\s+/).filter(Boolean);
    const hits: SearchHit[] = [];

    for (const page of entries) {
      const titleLower = page.title.toLowerCase();
      const descLower = page.description.toLowerCase();
      let bestSection: SearchSection | null = null;
      let bestScore = 0;

      // Score page-level title + description
      let pageScore = 0;
      let allTermsInPage = true;
      const fullPageLower = `${titleLower} ${descLower} ${page.sections.map((s) => `${s.heading} ${s.text}`).join(" ").toLowerCase()}`;
      for (const term of terms) {
        if (!fullPageLower.includes(term)) {
          allTermsInPage = false;
          break;
        }
      }
      if (!allTermsInPage) continue;

      if (titleLower === query) pageScore += 120;
      else if (titleLower.includes(query)) pageScore += 80;
      for (const term of terms) {
        if (titleLower.includes(term)) pageScore += 30;
        if (descLower.includes(term)) pageScore += 12;
      }

      for (const sec of page.sections) {
        const hLower = sec.heading.toLowerCase();
        const tLower = sec.text.toLowerCase();
        let secScore = pageScore;
        if (hLower && hLower.includes(query)) secScore += 50;
        if (tLower.includes(query)) secScore += 25;
        for (const term of terms) {
          if (hLower.includes(term)) secScore += 20;
          if (tLower.includes(term)) secScore += 8;
        }
        if (secScore > bestScore) {
          bestScore = secScore;
          bestSection = sec;
        }
      }

      const finalScore = Math.max(pageScore, bestScore);
      if (finalScore <= 0) continue;

      const anchor = bestSection?.anchor ? `#${bestSection.anchor}` : "";
      const rawText = bestSection?.text || page.description;
      hits.push({
        url: `${baseUrl}${page.url}${anchor}`,
        title: page.title,
        heading: bestSection?.heading ?? "",
        excerpt: makeExcerpt(rawText, terms),
        score: finalScore,
      });
    }

    hits.sort((a, b) => b.score - a.score);
    return hits.slice(0, 15);
  }

  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const openBtn = this.querySelector<HTMLButtonElement>("button[data-open-modal]");
      const closeBtn = this.querySelector<HTMLButtonElement>("button[data-close-modal]");
      const dialog = this.querySelector<HTMLDialogElement>("dialog");
      const frame = this.querySelector<HTMLDivElement>(".dialog-frame");
      const input = this.querySelector<HTMLInputElement>(".search-input");
      const clearBtn = this.querySelector<HTMLButtonElement>(".search-clear");
      const statusEl = this.querySelector<HTMLDivElement>(".search-status");
      const resultsEl = this.querySelector<HTMLOListElement>(".search-results");
      const modKbd = this.querySelector<HTMLElement>("[data-shortcut-mod]");
      if (!openBtn || !closeBtn || !dialog || !frame || !input || !clearBtn || !statusEl || !resultsEl) {
        return;
      }

      const isMac = /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform || navigator.userAgent);
      if (modKbd && !isMac) modKbd.textContent = "Ctrl";

      const indexUrl = this.dataset.indexUrl ?? "/search-index.json";
      const baseUrl = this.dataset.baseUrl ?? "";
      let activeIndex = -1;

      const setActive = (idx: number) => {
        const items = Array.from(resultsEl.querySelectorAll<HTMLAnchorElement>("a.search-result-link"));
        if (items.length === 0) {
          activeIndex = -1;
          return;
        }
        activeIndex = ((idx % items.length) + items.length) % items.length;
        items.forEach((a, i) => {
          const isCurrent = i === activeIndex;
          a.setAttribute("aria-selected", String(isCurrent));
          a.classList.toggle("is-active", isCurrent);
          if (isCurrent) a.scrollIntoView({ block: "nearest" });
        });
      };

      const render = async () => {
        const q = input.value;
        clearBtn.hidden = q.length === 0;
        const trimmed = q.trim();
        if (!trimmed) {
          statusEl.textContent = "Type to search Spana docs…";
          resultsEl.innerHTML = "";
          activeIndex = -1;
          return;
        }
        try {
          if (!cachedIndex) {
            statusEl.textContent = `Searching for "${trimmed}"…`;
          }
          const entries = await loadIndex(indexUrl);
          if (input.value !== q) return;
          const terms = trimmed.toLowerCase().split(/\s+/).filter(Boolean);
          const hits = searchDocs(entries, trimmed, baseUrl);
          if (hits.length === 0) {
            statusEl.textContent = `No results for "${trimmed}"`;
            resultsEl.innerHTML = "";
            activeIndex = -1;
            return;
          }
          statusEl.textContent = `${hits.length} result${hits.length === 1 ? "" : "s"} for "${trimmed}"`;
          resultsEl.innerHTML = hits
            .map((hit, idx) => {
              const titleHtml = highlight(hit.title, terms);
              const headingHtml = hit.heading ? `<span class="search-result-sep">›</span><span class="search-result-heading">${highlight(hit.heading, terms)}</span>` : "";
              const excerptHtml = hit.excerpt ? `<p class="search-result-excerpt">${highlight(hit.excerpt, terms)}</p>` : "";
              return `<li role="option"><a class="search-result-link${idx === 0 ? " is-active" : ""}" aria-selected="${idx === 0}" href="${escapeHtml(hit.url)}"><div class="search-result-title"><strong>${titleHtml}</strong>${headingHtml}</div>${excerptHtml}</a></li>`;
            })
            .join("");
          activeIndex = 0;
        } catch {
          statusEl.textContent = "Search index failed to load. Please try again.";
          resultsEl.innerHTML = "";
        }
      };

      const openModal = (event?: MouseEvent) => {
        if (dialog.open) return;
        dialog.showModal();
        document.body.toggleAttribute("data-search-modal-open", true);
        void loadIndex(indexUrl).catch(() => {});
        input.focus();
        input.select();
        void render();
        event?.stopPropagation();
      };

      const closeModal = () => {
        if (!dialog.open) return;
        dialog.close();
      };

      dialog.addEventListener("close", () => {
        document.body.toggleAttribute("data-search-modal-open", false);
      });

      dialog.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (target?.closest("a.search-result-link")) {
          closeModal();
          return;
        }
        if (target && !frame.contains(target)) {
          closeModal();
        }
      });

      openBtn.addEventListener("click", openModal);
      closeBtn.addEventListener("click", closeModal);
      clearBtn.addEventListener("click", () => {
        input.value = "";
        input.focus();
        void render();
      });

      input.addEventListener("input", () => {
        void render();
      });

      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActive(activeIndex + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActive(activeIndex - 1);
        } else if (event.key === "Enter" && activeIndex >= 0) {
          const items = resultsEl.querySelectorAll<HTMLAnchorElement>("a.search-result-link");
          const target = items[activeIndex];
          if (target) {
            event.preventDefault();
            closeModal();
            window.location.href = target.href;
          }
        }
      });

      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (dialog.open) closeModal();
          else openModal();
        } else if (
          event.key === "/" &&
          !dialog.open &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.altKey &&
          !(event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement || (event.target as HTMLElement)?.isContentEditable)
        ) {
          event.preventDefault();
          openModal();
        }
      });
    }
  }

  if (!customElements.get("site-search")) {
    customElements.define("site-search", SiteSearch);
  }
</script>

<style>
  site-search {
    display: contents;
  }

  button[data-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    background-color: transparent;
    color: var(--sl-color-gray-1);
    cursor: pointer;
    height: 2.5rem;
    font-size: var(--sl-text-xl);
  }

  @media (min-width: 50rem) {
    button[data-open-modal] {
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding-inline-start: 0.75rem;
      padding-inline-end: 0.5rem;
      background-color: var(--sl-color-black);
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      width: 100%;
      max-width: 22rem;
    }
    button[data-open-modal]:hover {
      border-color: var(--sl-color-gray-2);
      color: var(--sl-color-white);
    }
    button[data-open-modal] > kbd {
      margin-inline-start: auto;
      border-radius: 0.25rem;
      font-size: var(--sl-text-2xs);
      gap: 0.25em;
      padding: 0.175rem 0.35rem;
      background-color: var(--sl-color-gray-6);
      color: var(--sl-color-gray-2);
    }
  }

  dialog {
    margin: 0;
    padding: 0;
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    box-shadow: var(--sl-shadow-lg);
    color: var(--sl-color-white);
  }

  dialog[open] {
    display: flex;
  }

  dialog::backdrop {
    background-color: var(--sl-color-backdrop-overlay, rgba(0, 0, 0, 0.65));
    backdrop-filter: blur(0.25rem);
  }

  @media (min-width: 50rem) {
    dialog {
      margin: 4rem auto auto;
      border-radius: 0.75rem;
      width: 90%;
      max-width: 40rem;
      height: max-content;
      min-height: 15rem;
      max-height: calc(100% - 8rem);
    }
  }

  .dialog-frame {
    flex-direction: column;
    flex-grow: 1;
    gap: 0.75rem;
    padding: 1rem;
    min-height: 0;
    width: 100%;
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
  }

  .search-icon {
    position: absolute;
    left: 0.8rem;
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 2.75rem;
    padding: 0 2.4rem 0 2.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-accent);
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 1rem;
    outline: none;
  }

  .search-input:focus-visible {
    box-shadow: 0 0 0 2px var(--sl-color-accent-low);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-clear {
    position: absolute;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--sl-color-accent-high);
    cursor: pointer;
  }

  .search-clear:hover {
    background-color: var(--sl-color-gray-5);
  }

  .search-cancel {
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .search-cancel:hover {
    color: var(--sl-color-white);
  }

  .search-status {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    padding-inline: 0.25rem;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    overflow-y: auto;
    max-height: 24rem;
  }

  :global(.search-result-link) {
    display: block;
    padding: 0.65rem 0.8rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    text-decoration: none;
  }

  :global(.search-result-link:hover),
  :global(.search-result-link.is-active) {
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-accent-low);
  }

  :global(.search-result-title) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-size: var(--sl-text-sm);
  }

  :global(.search-result-sep) {
    color: var(--sl-color-gray-3);
  }

  :global(.search-result-heading) {
    color: var(--sl-color-accent-high);
    font-weight: 500;
  }

  :global(.search-result-excerpt) {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    line-height: 1.45;
  }

  :global(.search-result-link mark) {
    background: transparent;
    color: var(--sl-color-accent-high);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .search-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .search-footer kbd {
    display: inline-block;
    padding: 0.05rem 0.3rem;
    margin-inline-end: 0.2rem;
    border-radius: 0.25rem;
    background-color: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    font-size: 0.7rem;
  }
</style>
