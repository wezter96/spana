{
  "name": "spana",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.7",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "prepare": "lefthook install && effect-language-service patch",
    "lint": "oxlint .",
    "test": "bun test --isolate packages",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:tui": "turbo -F tui dev",
    "studio": "bun run --cwd packages/spana dist/cli.js studio",
    "test:e2e:framework-app": "bun run --cwd packages/spana test:e2e:framework-app",
    "publish:spana": "cd packages/spana && bun run build && npm publish --access public",
    "check": "bun run lint && oxfmt --write"
  },
  "dependencies": {
    "@spana/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/code-frame": "^7.29.7",
    "@effect/language-service": "^0.87.5",
    "@spana/config": "workspace:*",
    "@types/node": "^25.9.12",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.5"
}
